    },
    "scripts": {
        "start": "node bin/webmake.js dev",
        "link": "npm link",
        "pack:check": "npm pack --dry-run"
    },
    "dependencies": {
        "chokidar": "^3.6.0",
        "dotenv": "^16.4.5",
        "webmake-cli": "^1.0.0",
        "ws": "^8.17.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
