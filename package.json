{
    "name": "webmake-cli",
    "version": "1.0.0",
    "description": "WebMake Studio - Local dev server, build toolkit and deploy CLI",
    "keywords": [
        "webmake",
        "dev-server",
        "cli",
        "livereload",
        "static-server"
    ],
    "license": "MIT",
    "author": "WebMake Studio",
    "type": "commonjs",
    "main": "./src/index.js",
    "bin": {
        "webmake": "bin/webmake.js"
    },
    "files": [
        "bin",
        "src",
        "scripts",
        "README.md",
        "package.json"
    ],
